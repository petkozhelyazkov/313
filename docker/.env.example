# Copy to .env (already gitignored). Adjust for your local setup.

# MySQL credentials — only used by the docker-compose stack
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=trading212_dev
MYSQL_USER=trading212
MYSQL_PASSWORD=trading212pass

# Host port mappings
# Defaults dodge a system MySQL on 3306 and the `billing-backend` project's
# MySQL containers on 3307/3308 and phpMyAdmin on 8080. Adjust freely.
MYSQL_PORT=3310
ADMINER_PORT=8081
