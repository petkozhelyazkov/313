root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C# / .NET
[*.{cs,csproj,sln,props,targets}]
indent_size = 4

# XML files
[*.{xml,xsd,xsl,resx,config}]
indent_size = 2

# TypeScript / JavaScript / React
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# Web
[*.{html,css,scss,sass,less}]
indent_size = 2

# Data / Config
[*.{json,yaml,yml,toml}]
indent_size = 2

# Markdown — preserve trailing whitespace for line breaks
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Shell
[*.{sh,bash}]
indent_size = 2

# Makefiles need tabs
[Makefile]
indent_style = tab
